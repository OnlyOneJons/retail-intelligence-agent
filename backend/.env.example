# Server Configuration
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:5173","http://localhost:5174","http://localhost:5175","http://localhost:5176"]

# LLM Configuration (Supports Atlas Cloud, OpenAI, Azure, Gemini, Ollama)
OPENAI_API_KEY=mock-key-or-real-api-key
OPENAI_BASE_URL=https://api.openai.com/v1
DEFAULT_LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.2

# Monorepo Downstream Microservice URLs
OMNICORE_API_URL=http://localhost:3000
CLEARSETTLE_API_URL=http://localhost:3001
EDGEPULSE_API_URL=http://localhost:3002

# Observability
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
